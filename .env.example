# Data layer
DATA_BACKEND=memory
# DATA_BACKEND=postgres
# DATA_BACKEND=supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_app

# LLM provider
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# API auth for /api/cases/* endpoints
API_AUTH_KEY=change-me
N8N_WEBHOOK_URL=https://hkbt.app.n8n.cloud/webhook/insurance-intake-codex-v3

# Optional Google Slides rendering
GOOGLE_SLIDES_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SLIDES_FOLDER_ID=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback

# LINE EV support chatbot
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_REPLY_API_URL=https://api.line.me/v2/bot/message/reply
LINE_PUSH_API_URL=https://api.line.me/v2/bot/message/push
LINE_SUPPORT_GROUP_ID=
EV_N8N_WEBHOOK_URL=
EV_BOT_DISPLAY_NAME=EV Charging Support
EV_DEFAULT_LANGUAGE=en-US
EV_ENABLE_THAI_AFTER_SETUP=false
EV_FAQ_PATH=/absolute/path/to/ev_faq.json
EV_CHAT_LOG_DB_PATH=/absolute/path/to/chat_logs.db
EV_MEDIA_STORAGE_DIR=/absolute/path/to/line_media
