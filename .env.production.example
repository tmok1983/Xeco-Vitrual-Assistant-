# XECO EV LINE chatbot production environment

# Core runtime
DATA_BACKEND=memory
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional API protection for non-LINE endpoints
API_AUTH_KEY=change-me

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_REPLY_API_URL=https://api.line.me/v2/bot/message/reply
LINE_PUSH_API_URL=https://api.line.me/v2/bot/message/push
LINE_SUPPORT_GROUP_ID=

# EV chatbot behavior
EV_FAQ_PATH=/app/data/xeco_faq_corpus.json
EV_BOT_DISPLAY_NAME=XECO EV Support
EV_DEFAULT_LANGUAGE=en-US
EV_ENABLE_THAI_AFTER_SETUP=false
EV_CHAT_LOG_DB_PATH=/app/runtime/chat_logs.db
EV_MEDIA_STORAGE_DIR=/app/runtime/line_media

# Optional future orchestration
EV_N8N_WEBHOOK_URL=

# Keep existing insurance settings disabled unless still needed
N8N_WEBHOOK_URL=
GOOGLE_SLIDES_ENABLED=false
GOOGLE_OAUTH_ENABLED=false
